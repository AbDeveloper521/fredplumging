# Sanity — get these from https://sanity.io/manage
# Project ID and dataset are public (they ship in the client bundle).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer-scope API token used for server-side reads by the app.
# Manage → API → Tokens → Add API token (permissions: Viewer).
# Server-only — must NEVER be prefixed NEXT_PUBLIC_ and never committed.
SANITY_API_READ_TOKEN=your-read-token

# Editor-scope token used ONLY by the scripts in scripts/ (seed, fix:slug).
# Manage → API → Tokens → Add API token (permissions: Editor).
# Never referenced from application code; never NEXT_PUBLIC_; local/CI only —
# it does not need to exist on the deployment host at all.
SANITY_API_WRITE_TOKEN=your-write-token

# Shared secret for the /api/revalidate webhook. Generate something long and
# random (e.g. `openssl rand -hex 32`) and paste the same value into the
# Sanity webhook's "Secret" field. Server-only — never NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=your-webhook-secret

# Google Places API (New) key — OPTIONAL. Only used by the off-by-default
# aggregate refresh in sanity/lib/getGoogleReviews.ts and the one-shot
# scripts/resolve-place-id.ts lookup. Leave unset to keep the Places layer
# fully disabled. Server-only — must NEVER be prefixed NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=your-places-key

# ── Real values live ONLY in .env.local (gitignored). This file is committed
#    to the repo as a template — never paste real tokens here.
